<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:WeatherApp.UI.Controls"
             x:Name="Root"
             x:Class="WeatherApp.UI.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">
            <Button Text="Show Weather"
                    Command="{Binding LoadWeatherCommand}" />

            <Label Text="{Binding WeatherText}" 
                   FontSize="20"
                   HorizontalOptions="Center" />
            <controls:WeatherCardView x:Name="WeatherCard" BindingContext="{Binding Source={x:Reference Root}, Path=Weather}"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
